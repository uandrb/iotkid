---
interface Props {
	loai: 'an-toan' | 'meo' | 'loi-hay-gap';
}

const { loai } = Astro.props;

const labels = {
	'an-toan': 'Cảnh báo an toàn',
	meo: 'Mẹo',
	'loi-hay-gap': 'Lỗi hay gặp'
};
---

<aside class={`box ${loai}`}>
	<strong>{labels[loai]}:</strong>
	<div class="content">
		<slot />
	</div>
</aside>

<style>
	.box {
		padding: var(--space-2);
		border-radius: var(--radius-md);
		margin-block: var(--space-2);
		border: 1px solid var(--color-border);
	}

	.an-toan {
		background: color-mix(in srgb, var(--color-warning) 15%, transparent);
	}

	.meo {
		background: color-mix(in srgb, var(--color-accent-teal) 15%, transparent);
	}

	.loi-hay-gap {
		background: color-mix(in srgb, var(--color-error) 15%, transparent);
	}
</style>
